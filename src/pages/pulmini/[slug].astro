---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getVan } from '../../lib/repo';
import { MIN_ADVANCE_DAYS, MIN_BOOKING_HOURS, PICKUP_MAPS_URL } from '../../lib/config';
import { USAGE_TYPES, AGE_GROUPS } from '../../lib/booking-rules';
import { vanLabel, seatsLabel } from '../../lib/vans';

const van = await getVan(Astro.params.slug!);
if (!van) return new Response('Pulmino non trovato', { status: 404 });

const label = vanLabel(van);
const hours = Array.from({ length: 24 }, (_, i) => i);
---

<PublicLayout
  title={`Richiedi ${label} — Basket Conselve`}
  heroTitle={`${van.name} • Basket Conselve`}
  heroSubtitle={[van.model, seatsLabel(van.seats)].filter(Boolean).join(' · ')}
>
  <style>
    .back-link { display: inline-block; margin-bottom: 1rem; color: #444; font-size: 0.9rem; font-weight: 600; text-decoration: none; }
    .back-link:hover { color: var(--red); }

    .steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
      margin-bottom: 1.5rem;
    }
    .step {
      background: white;
      border-radius: 10px;
      padding: 1rem 0.85rem;
      text-align: center;
      box-shadow: 0 2px 6px rgba(0,0,0,.05);
    }
    .step-num {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--red);
      color: white;
      font-weight: 800;
      font-size: 0.95rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.5rem;
    }
    .step-title { font-weight: 700; font-size: 0.95rem; color: #1a1a1a; margin-bottom: 0.25rem; }
    .step-desc { font-size: 0.8rem; color: #666; line-height: 1.4; }

    /* Period form */
    .period-card {
      background: white; border-radius: 10px; padding: 1.25rem;
      box-shadow: 0 2px 8px rgba(0,0,0,.08); margin-bottom: 1.25rem;
    }
    .period-card h2 { font-size: 1rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--red); margin-bottom: 1rem; }
    .period-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.5rem; }
    .period-field label { display: block; margin-bottom: 0.3rem; font-size: 0.8rem; font-weight: 700; color: #444; text-transform: uppercase; letter-spacing: 0.03em; }
    .period-inputs { display: flex; gap: 0.5rem; }
    .period-inputs select {
      padding: 0.55rem 0.7rem; border: 1.5px solid #ddd; border-radius: 7px;
      font-size: 1rem; font-family: inherit; background: white; min-height: 44px; width: 6.2rem;
    }
    .period-inputs select:focus { outline: none; border-color: var(--red); }

    .range-status {
      margin-top: 1rem; padding: 0.65rem 0.9rem; border-radius: 6px;
      font-size: 0.92rem; font-weight: 600; border-left: 4px solid #d1d5db; background: #f7f7f7; color: #555;
    }
    .range-status.ok { border-left-color: #16a34a; background: #f0fdf4; color: #166534; }
    .range-status.error { border-left-color: #dc2626; background: #fef2f2; color: #991b1b; }
    .period-actions { display: flex; justify-content: flex-end; margin-top: 1rem; }
    .period-actions .btn { padding: 0.8rem 1.6rem; }

    /* Modal */
    .modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,.55); z-index: 100;
      align-items: flex-start; justify-content: center;
      overflow-y: auto;
      padding: 1rem;
      -webkit-overflow-scrolling: touch;
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: white; border-radius: 12px; padding: 2rem;
      width: 100%; max-width: 560px; position: relative;
      box-shadow: 0 8px 32px rgba(0,0,0,.18);
      margin: auto 0;
    }
    .modal-header { border-bottom: 3px solid var(--red); padding-bottom: 0.75rem; margin-bottom: 1.25rem; }
    .modal-header h2 { font-size: 1.3rem; font-weight: 800; color: var(--red); }
    .form-section { margin-bottom: 0.5rem; }
    .form-section h3 {
      font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em;
      color: #888; margin: 0.25rem 0 0.75rem; padding-bottom: 0.35rem; border-bottom: 1px solid #eee;
    }
    .form-grid { display: grid; grid-template-columns: 1fr; }
    .modal label.field-label { display: block; margin-bottom: 0.3rem; font-size: 0.8rem; font-weight: 700; color: #444; text-transform: uppercase; letter-spacing: 0.03em; }
    .modal input[type="text"], .modal input[type="email"], .modal input[type="tel"], .modal input[type="number"],
    .modal select, .modal textarea {
      width: 100%; padding: 0.55rem 0.8rem; border: 1.5px solid #ddd; border-radius: 7px; margin-bottom: 1rem;
      font-size: 1rem; font-family: inherit; background: white; transition: border-color 0.15s;
    }
    .modal textarea { resize: vertical; min-height: 4.5rem; }
    .modal input:focus, .modal select:focus, .modal textarea:focus { outline: none; border-color: var(--red); }
    .modal input.error-field { border-color: #dc2626; margin-bottom: 0.25rem; }
    .field-error { color: #dc2626; font-size: 0.8rem; margin-bottom: 0.75rem; display: none; }
    .radio-row { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
    .radio-pill { flex: 1; position: relative; }
    .radio-pill input { position: absolute; opacity: 0; pointer-events: none; }
    .radio-pill span {
      display: block; text-align: center; padding: 0.55rem 0.5rem; border: 1.5px solid #ddd; border-radius: 7px;
      font-weight: 600; cursor: pointer; user-select: none; min-height: 44px; line-height: 1.7;
    }
    .radio-pill input:checked + span { background: var(--red); border-color: var(--red); color: white; }
    .radio-pill input:focus-visible + span { outline: 2px solid var(--red); outline-offset: 2px; }
    .declaration {
      display: flex; gap: 0.65rem; align-items: flex-start; cursor: pointer;
      background: #fafafa; border: 1.5px solid #e5e5e5; border-radius: 8px; padding: 0.75rem 0.85rem;
      font-size: 0.9rem; line-height: 1.45; color: #1a1a1a; margin: 0.25rem 0 1rem;
    }
    .declaration input { width: 1.15rem; height: 1.15rem; margin-top: 0.15rem; flex-shrink: 0; accent-color: var(--red); }
    .declaration.error-field { border-color: #dc2626; background: #fef2f2; }
    .disclaimer {
      font-size: 0.85rem; line-height: 1.5; color: #555;
      background: #fffbeb; border-left: 3px solid #f59e0b; border-radius: 4px; padding: 0.65rem 0.85rem;
    }
    .modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1rem; }
    .slot-info { background: #fff5f5; border-left: 3px solid var(--red); border-radius: 4px; padding: 0.5rem 0.75rem; margin-bottom: 1.25rem; font-size: 0.9rem; font-weight: 600; color: var(--red); line-height: 1.5; }
    .error-msg { color: #991b1b; background: #fef2f2; border-radius: 6px; padding: 0.55rem 0.75rem; font-size: 0.88rem; font-weight: 600; margin-bottom: 1rem; }
    .success-msg { color: #1a1a1a; font-size: 0.95rem; line-height: 1.55; margin-top: 0.5rem; }
    .success-msg h3 { font-size: 1.15rem; font-weight: 800; color: #16a34a; margin-bottom: 0.75rem; }
    .success-msg p { margin-bottom: 0.7rem; }
    .success-msg p:last-of-type { margin-bottom: 1rem; }
    .success-msg .spam-note {
      background: #fff3cd; border-left: 3px solid #f59e0b;
      padding: 0.6rem 0.85rem; border-radius: 4px;
      font-size: 0.9rem;
    }
    .success-msg .ok-btn { width: 100%; margin-top: 0.5rem; }

    @media (max-width: 640px) {
      .steps { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
      .step { padding: 0.75rem 0.6rem; }
      .step-num { width: 28px; height: 28px; font-size: 0.85rem; }
      .step-title { font-size: 0.88rem; }
      .step-desc { font-size: 0.75rem; }
      .period-grid { grid-template-columns: 1fr; }
      .period-actions .btn { width: 100%; min-height: 50px; font-size: 1rem; }
      .modal { padding: 1.25rem; margin: 0.75rem; max-width: 100%; }
      .modal-actions { flex-direction: column-reverse; gap: 0.5rem; }
      .modal-actions .btn { width: 100%; padding: 0.95rem; font-size: 1rem; min-height: 48px; }
    }
  </style>
  <style is:global>
    /* Elements created by JS libraries (flatpickr, intl-tel-input): styles must be global */
    .period-inputs input {
      box-sizing: border-box; flex: 1; min-width: 0; width: 100%;
      padding: 0.55rem 0.7rem; border: 1.5px solid #ddd; border-radius: 7px;
      font-size: 1rem; font-family: inherit; background: white; min-height: 44px; color: #1a1a1a;
      cursor: pointer;
    }
    .period-inputs input:focus { outline: none; border-color: var(--red); }
    .flatpickr-day.selected, .flatpickr-day.selected:hover { background: #C8102E !important; border-color: #C8102E !important; }
    .flatpickr-day.today { border-color: #C8102E; }
    .flatpickr-day:hover { background: #fdecef; }
    .modal .iti { width: 100%; margin-bottom: 1rem; display: block; }
    .modal .iti input { margin-bottom: 0 !important; }
    .iti__tel-input { width: 100%; }
    .alternatives { margin-top: 0.75rem; padding-top: 0.65rem; border-top: 1px solid #fecaca; color: #1a1a1a; font-weight: 500; }
    .alternatives-title { font-weight: 700; margin-bottom: 0.45rem; }
    .alternative {
      display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;
      background: white; border: 1.5px solid #bbf7d0; border-radius: 7px;
      padding: 0.55rem 0.8rem; margin-top: 0.4rem; color: #1a1a1a; text-decoration: none;
      transition: border-color 0.1s, transform 0.1s;
    }
    .alternative:hover { border-color: #16a34a; }
    .alternative:active { transform: scale(0.99); }
    .alternative-cta { color: #16a34a; font-weight: 700; white-space: nowrap; }
    .range-summary { display: block; font-weight: 500; color: #333; margin-top: 0.2rem; font-size: 0.88rem; }
  </style>

  <a class="back-link" href="/">← Tutti i pulmini</a>

  <div class="steps">
    <div class="step">
      <div class="step-num">1</div>
      <div class="step-title">Scegli le date</div>
      <div class="step-desc">Indica ritiro e riconsegna del pulmino</div>
    </div>
    <div class="step">
      <div class="step-num">2</div>
      <div class="step-title">Invia la richiesta</div>
      <div class="step-desc">Compila il modulo con i dati dell'associazione e del conducente</div>
    </div>
    <div class="step">
      <div class="step-num">3</div>
      <div class="step-title">Attendi conferma</div>
      <div class="step-desc">Riceverai un'email quando la richiesta sarà accettata o rifiutata</div>
    </div>
    <div class="step">
      <div class="step-num">4</div>
      <div class="step-title">Buon viaggio</div>
      <div class="step-desc">Ritira il pulmino all'orario concordato</div>
    </div>
  </div>

  <div class="info-box">
    <strong>⚠️ Importante</strong>
    <ul>
      <li>{label}: {seatsLabel(van.seats)}</li>
      <li>Le richieste vanno inviate con almeno <strong>{MIN_ADVANCE_DAYS} giorni</strong> di anticipo</li>
      <li>Durata minima {MIN_BOOKING_HOURS} ora, a ore intere; puoi richiedere il mezzo anche per più giorni</li>
      <li>L'invio non costituisce conferma: la prenotazione diventa valida solo dopo l'accettazione scritta di Basket Conselve ASD</li>
    </ul>
  </div>

  <div class="info-box">
    <strong>🚐 Ritiro e riconsegna</strong>
    <ul>
      {van.pickup_location && <li><strong>Dove:</strong> {van.pickup_location} · <a href={PICKUP_MAPS_URL} target="_blank" rel="noopener">Apri in Maps</a></li>}
      <li><strong>Foto o video obbligatori</strong> dello stato del mezzo, al ritiro e alla riconsegna</li>
      <li>Orario e chilometri vanno registrati nel libretto di bordo elettronico, alla partenza e al rientro</li>
      {van.return_instructions && <li>{van.return_instructions}</li>}
      <li>Tutti i dettagli: <a href="/istruzioni">istruzioni per ritiro e riconsegna</a> · <a href="/disciplinare.pdf" target="_blank" rel="noopener">disciplinare (PDF)</a></li>
    </ul>
  </div>

  <div class="period-card" id="period-card" data-van={van.id} data-van-label={label}>
    <h2>Periodo di utilizzo</h2>
    <div class="period-grid">
      <div class="period-field">
        <label for="start-date">Ritiro (dal)</label>
        <div class="period-inputs">
          <input type="text" id="start-date" />
          <select id="start-hour" aria-label="Ora di ritiro">
            {hours.map((h) => <option value={h} selected={h === 9}>{String(h).padStart(2, '0')}:00</option>)}
          </select>
        </div>
      </div>
      <div class="period-field">
        <label for="end-date">Riconsegna (al)</label>
        <div class="period-inputs">
          <input type="text" id="end-date" />
          <select id="end-hour" aria-label="Ora di riconsegna">
            {hours.map((h) => <option value={h} selected={h === 18}>{String(h).padStart(2, '0')}:00</option>)}
          </select>
        </div>
      </div>
    </div>
    <div class="range-status" id="range-status">Scegli data e ora di ritiro e di riconsegna.</div>
    <div class="period-actions">
      <button class="btn btn-primary" id="book-btn" disabled>Compila la richiesta →</button>
    </div>
  </div>

  <div class="modal-overlay" id="modal-overlay">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-header"><h2 id="modal-title">Richiesta di utilizzo</h2></div>
      <div class="slot-info" id="modal-slot-info"></div>
      <div class="error-msg" id="modal-error" role="alert" style="display:none"></div>
      <div id="modal-form">
        <div class="form-section">
          <h3>Referente</h3>
          <div class="form-grid">
            <div class="full">
              <label class="field-label" for="inp-name">Nome e cognome del referente *</label>
              <input id="inp-name" type="text" autocomplete="name" required />
            </div>
            <div class="full">
              <label class="field-label" for="inp-company">Associazione / società sportiva *</label>
              <input id="inp-company" type="text" autocomplete="organization" required />
            </div>
            <div>
              <label class="field-label" for="inp-email">Email *</label>
              <input id="inp-email" type="email" autocomplete="email" required />
              <div class="field-error" id="email-error">Inserisci un'email valida.</div>
            </div>
            <div>
              <label class="field-label" for="inp-email-confirm">Conferma email *</label>
              <input id="inp-email-confirm" type="email" required />
              <div class="field-error" id="email-confirm-error">Le email non corrispondono.</div>
            </div>
            <div class="full">
              <label class="field-label" for="inp-phone">Telefono *</label>
              <input id="inp-phone" type="tel" placeholder="333 123 4567" required />
            </div>
          </div>
        </div>

        <div class="form-section">
          <h3>Utilizzo</h3>
          <div class="form-grid">
            <div class="full">
              <label class="field-label" for="inp-destination">Destinazione *</label>
              <input id="inp-destination" type="text" placeholder="es. Palazzetto di Padova" required />
            </div>
            <div>
              <label class="field-label" for="inp-usage">Tipologia di utilizzo *</label>
              <select id="inp-usage" required>
                <option value="" selected disabled>Seleziona…</option>
                {Object.entries(USAGE_TYPES).map(([value, text]) => <option value={value}>{text}</option>)}
              </select>
            </div>
            <div>
              <label class="field-label" for="inp-km">Km complessivi stimati *</label>
              <input id="inp-km" type="number" inputmode="numeric" min="1" step="1" placeholder="es. 80" required />
            </div>
            <div class="full">
              <span class="field-label" id="age-label" style="display:block;margin-bottom:0.3rem;font-size:0.8rem;font-weight:700;color:#444;text-transform:uppercase;letter-spacing:0.03em;">Fascia d'età *</span>
              <div class="radio-row" role="radiogroup" aria-labelledby="age-label">
                {Object.entries(AGE_GROUPS).map(([value, text]) => (
                  <label class="radio-pill"><input type="radio" name="age-group" value={value} /><span>{text}</span></label>
                ))}
              </div>
            </div>
            <div class="full">
              <label class="field-label" for="inp-notes">Note</label>
              <textarea id="inp-notes" maxlength="1000"></textarea>
            </div>
          </div>
        </div>

        <div class="form-section">
          <h3>Conducente</h3>
          <div class="form-grid">
            <div>
              <label class="field-label" for="inp-driver-name">Nome e cognome del conducente *</label>
              <input id="inp-driver-name" type="text" required />
            </div>
            <div>
              <label class="field-label" for="inp-driver-phone">Telefono del conducente *</label>
              <input id="inp-driver-phone" type="tel" placeholder="333 123 4567" required />
            </div>
          </div>
          <label class="declaration" id="declaration">
            <input type="checkbox" id="inp-license" required />
            <span>L'associazione dichiara che il conducente indicato possiede una patente di categoria B o superiore, in corso di validità e idonea alla conduzione del mezzo richiesto. *</span>
          </label>
        </div>

        <p class="disclaimer">
          La richiesta è presentata nell'ambito del <a href="/disciplinare.pdf" target="_blank" rel="noopener">disciplinare</a> già sottoscritto dall'associazione.
          L'invio non costituisce conferma della prenotazione, che diventerà valida soltanto dopo
          l'accettazione scritta di Basket Conselve ASD.
        </p>

        <div class="modal-actions">
          <button class="btn btn-secondary" id="modal-cancel">Annulla</button>
          <button class="btn btn-primary" id="modal-submit">Invia richiesta</button>
        </div>
      </div>
      <div class="success-msg" id="modal-success" style="display:none">
        <h3>Richiesta inviata!</h3>
        <p>Abbiamo mandato un'email di riepilogo a <strong id="success-email"></strong>.</p>
        <p class="spam-note">
          Se non la trovi entro pochi minuti, controlla la cartella <strong>spam</strong>.
          Se è lì, segnala come <strong>"Non è spam"</strong> per ricevere correttamente
          le prossime comunicazioni.
        </p>
        <p>La richiesta è in attesa di valutazione: riceverai un'altra email quando sarà accettata o rifiutata. Fino ad allora il mezzo non è assegnato.</p>
        <p>Nel frattempo leggi le <a href="/istruzioni" target="_blank">istruzioni per il ritiro e la riconsegna</a>: foto o video del mezzo sono obbligatori.</p>
        <button class="btn btn-primary ok-btn" id="modal-success-ok">Ho capito</button>
      </div>
    </div>
  </div>

  <script>
    import flatpickr from 'flatpickr';
    import { Italian } from 'flatpickr/dist/l10n/it.js';
    import 'flatpickr/dist/flatpickr.min.css';
    import intlTelInput from 'intl-tel-input';
    import 'intl-tel-input/dist/css/intlTelInput.css';

    import { BOOKING_HORIZON_MS } from '../../lib/config';
    import {
      validateBookingRange, rangesOverlap, earliestBookableStart, parseBookingDetails, EMAIL_RE, type Range,
    } from '../../lib/booking-rules';
    import { romeDateTime, romeDateStr, formatRange, formatDuration, getRomeParts } from '../../lib/time';
    import { seatsLabel } from '../../lib/vans';

    const card = document.getElementById('period-card')!;
    const VAN_ID = card.dataset.van!;
    const VAN_LABEL = card.dataset.vanLabel!;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const startDateInp = $<HTMLInputElement>('start-date');
    const startHourSel = $<HTMLSelectElement>('start-hour');
    const endDateInp = $<HTMLInputElement>('end-date');
    const endHourSel = $<HTMLSelectElement>('end-hour');
    const statusEl = $('range-status');
    const bookBtn = $<HTMLButtonElement>('book-btn');

    const earliest = earliestBookableStart(new Date());
    const earliestStr = romeDateStr(earliest);
    const horizonStr = romeDateStr(new Date(Date.now() + BOOKING_HORIZON_MS));

    // Date pickers: the input keeps "YYYY-MM-DD", the user sees "gg/mm/aaaa" on every device
    const pickerOptions = {
      locale: Italian,
      dateFormat: 'Y-m-d',
      altInput: true,
      altFormat: 'd/m/Y',
      allowInput: false,
      disableMobile: true,
      minDate: earliestStr,
      maxDate: horizonStr,
    };
    const startPicker = flatpickr(startDateInp, { ...pickerOptions });
    const endPicker = flatpickr(endDateInp, { ...pickerOptions });
    startPicker.altInput!.placeholder = 'gg/mm/aaaa';
    endPicker.altInput!.placeholder = 'gg/mm/aaaa';

    // ── Availability of this van (single fetch for the whole horizon) ──────
    type SlotData = {
      bookings: { start_at: string; end_at: string; status: string }[];
      blocked: { start_at: string; end_at: string; reason: string | null }[];
    };
    let slotData: SlotData = { bookings: [], blocked: [] };
    let loadedAt = 0;
    const CACHE_TTL_MS = 5 * 60 * 1000;

    async function loadSlots(): Promise<void> {
      const from = romeDateStr(new Date());
      const res = await fetch(`/api/slots?van=${encodeURIComponent(VAN_ID)}&from=${from}&to=${horizonStr}`).catch(() => null);
      if (res?.ok) {
        slotData = await res.json();
        loadedAt = Date.now();
      }
    }

    function busyRanges(): (Range & { kind: 'booked' | 'blocked' })[] {
      return [
        ...slotData.bookings.map((b) => ({ start: new Date(b.start_at), end: new Date(b.end_at), kind: 'booked' as const })),
        ...slotData.blocked.map((b) => ({ start: new Date(b.start_at), end: new Date(b.end_at), kind: 'blocked' as const })),
      ];
    }

    // ── Selected period ────────────────────────────────────────────────────
    function readRange(): Range | null {
      if (!startDateInp.value || !endDateInp.value) return null;
      return {
        start: romeDateTime(startDateInp.value, Number(startHourSel.value)),
        end: romeDateTime(endDateInp.value, Number(endHourSel.value)),
      };
    }

    let validRange: Range | null = null;

    function setStatus(kind: '' | 'ok' | 'error', title: string, summary = '') {
      statusEl.className = `range-status ${kind}`;
      statusEl.textContent = title;
      if (summary) {
        const s = document.createElement('span');
        s.className = 'range-summary';
        s.textContent = summary;
        statusEl.appendChild(s);
      }
    }

    // When this van is busy, suggest the other vans that are free for the same period
    let alternativesToken = 0;
    async function showAlternatives(range: Range) {
      const token = ++alternativesToken;
      const params = new URLSearchParams({ start: range.start.toISOString(), end: range.end.toISOString(), exclude: VAN_ID });
      const res = await fetch(`/api/availability?${params}`).catch(() => null);
      if (!res?.ok || token !== alternativesToken) return;
      const { free } = (await res.json()) as { free: { id: string; label: string; seats: number }[] };

      const box = document.createElement('div');
      box.className = 'alternatives';
      if (free.length === 0) {
        box.textContent = 'Purtroppo in questo periodo non ci sono altri pulmini liberi.';
      } else {
        const title = document.createElement('div');
        title.className = 'alternatives-title';
        title.textContent = free.length === 1
          ? '👉 In questo periodo è libero un altro pulmino:'
          : '👉 In questo periodo sono liberi altri pulmini:';
        box.appendChild(title);
        for (const van of free) {
          const link = document.createElement('a');
          link.className = 'alternative';
          link.href = `/pulmini/${van.id}?${new URLSearchParams({ start: range.start.toISOString(), end: range.end.toISOString() })}`;
          const text = document.createElement('span');
          const strong = document.createElement('strong');
          strong.textContent = van.label;
          text.append(strong, ` · ${seatsLabel(van.seats)}`);
          const cta = document.createElement('span');
          cta.className = 'alternative-cta';
          cta.textContent = 'Richiedi questo →';
          link.append(text, cta);
          box.appendChild(link);
        }
      }
      statusEl.appendChild(box);
    }

    function evaluate() {
      validRange = null;
      alternativesToken++; // drop any in-flight suggestion for a previous period
      endPicker.set('minDate', startDateInp.value || earliestStr);
      const range = readRange();
      if (!range) {
        setStatus('', 'Scegli data e ora di ritiro e di riconsegna.');
      } else {
        const summary = `${formatRange(range.start, range.end)} · ${formatDuration(range.end.getTime() - range.start.getTime())}`;
        const invalid = validateBookingRange(range.start, range.end);
        if (invalid) {
          setStatus('error', `❌ ${invalid}`, range.end > range.start ? summary : '');
        } else {
          const clash = busyRanges().find((b) => rangesOverlap(range, b));
          if (clash) {
            setStatus('error', `❌ ${VAN_LABEL} non è disponibile in questo periodo`, summary);
            showAlternatives(range);
          } else {
            validRange = range;
            setStatus('ok', `✅ ${VAN_LABEL} disponibile`, summary);
          }
        }
      }
      bookBtn.disabled = !validRange;
    }

    [startDateInp, startHourSel, endDateInp, endHourSel].forEach((el) => el.addEventListener('change', (e) => {
      // Pick a sensible default end when only the start is set
      if (e.target === startDateInp && startDateInp.value && (!endDateInp.value || endDateInp.value < startDateInp.value)) {
        endPicker.setDate(startDateInp.value, false);
      }
      evaluate();
    }));

    // Prefill from a suggestion link (?start=ISO&end=ISO)
    const params = new URLSearchParams(window.location.search);
    const preStart = new Date(params.get('start') ?? '');
    const preEnd = new Date(params.get('end') ?? '');
    if (!isNaN(preStart.getTime()) && !isNaN(preEnd.getTime())) {
      startPicker.setDate(romeDateStr(preStart), false);
      startHourSel.value = String(getRomeParts(preStart).hour);
      endPicker.setDate(romeDateStr(preEnd), false);
      endHourSel.value = String(getRomeParts(preEnd).hour);
    }

    loadSlots().then(evaluate);
    evaluate();

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && Date.now() - loadedAt > CACHE_TTL_MS) loadSlots().then(evaluate);
    });

    // ── Request modal ──────────────────────────────────────────────────────
    const telOptions = { initialCountry: 'it', loadUtils: () => import('intl-tel-input/utils') };
    const itiPhone = intlTelInput($<HTMLInputElement>('inp-phone'), telOptions);
    const itiDriver = intlTelInput($<HTMLInputElement>('inp-driver-phone'), telOptions);

    const TEXT_FIELDS = [
      'inp-name', 'inp-company', 'inp-email', 'inp-email-confirm', 'inp-phone',
      'inp-destination', 'inp-km', 'inp-notes', 'inp-driver-name', 'inp-driver-phone',
    ];

    function resetForm() {
      TEXT_FIELDS.forEach((id) => ($<HTMLInputElement>(id).value = ''));
      $<HTMLSelectElement>('inp-usage').value = '';
      document.querySelectorAll<HTMLInputElement>('input[name="age-group"]').forEach((r) => (r.checked = false));
      $<HTMLInputElement>('inp-license').checked = false;
      $('declaration').classList.remove('error-field');
      $('email-confirm-error').style.display = 'none';
      $('inp-email-confirm').classList.remove('error-field');
    }

    bookBtn.addEventListener('click', () => {
      if (!validRange) return;
      const r = validRange;
      $('modal-slot-info').textContent = `${VAN_LABEL}: ${formatRange(r.start, r.end)} (${formatDuration(r.end.getTime() - r.start.getTime())})`;
      $('modal-error').style.display = 'none';
      $('modal-form').style.display = 'block';
      $('modal-success').style.display = 'none';
      $('modal-overlay').classList.add('open');
      $('modal-overlay').scrollTop = 0;
      document.body.classList.add('modal-open');
    });

    function closeBookingModal() {
      $('modal-overlay').classList.remove('open');
      document.body.classList.remove('modal-open');
    }
    const isSuccessShowing = () => $('modal-success').style.display !== 'none';

    $('modal-cancel').addEventListener('click', closeBookingModal);
    $('modal-success-ok').addEventListener('click', closeBookingModal);
    $('modal-overlay').addEventListener('click', (e) => {
      // While showing the success state, only the "Ho capito" button can close.
      if (isSuccessShowing()) return;
      if (e.target === $('modal-overlay')) closeBookingModal();
    });

    function checkEmailMatch() {
      const email = $<HTMLInputElement>('inp-email').value.trim();
      const confirmInput = $<HTMLInputElement>('inp-email-confirm');
      const mismatch = !!confirmInput.value.trim() && email !== confirmInput.value.trim();
      $('email-confirm-error').style.display = mismatch ? 'block' : 'none';
      confirmInput.classList.toggle('error-field', mismatch);
    }

    $('inp-email').addEventListener('input', () => {
      const emailInput = $<HTMLInputElement>('inp-email');
      const email = emailInput.value.trim();
      const invalid = !!email && !EMAIL_RE.test(email);
      $('email-error').style.display = invalid ? 'block' : 'none';
      emailInput.classList.toggle('error-field', invalid);
      checkEmailMatch();
    });
    $('inp-email-confirm').addEventListener('input', checkEmailMatch);
    $('inp-license').addEventListener('change', () => $('declaration').classList.remove('error-field'));

    $('modal-submit').addEventListener('click', async () => {
      const errEl = $('modal-error');
      const fail = (msg: string) => {
        errEl.textContent = msg;
        errEl.style.display = 'block';
        errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };
      const val = (id: string) => $<HTMLInputElement>(id).value.trim();

      const body = {
        name: val('inp-name'),
        company: val('inp-company'),
        email: val('inp-email'),
        phone: itiPhone.getNumber() || '',
        destination: val('inp-destination'),
        usage_type: $<HTMLSelectElement>('inp-usage').value,
        age_group: document.querySelector<HTMLInputElement>('input[name="age-group"]:checked')?.value ?? '',
        estimated_km: val('inp-km'),
        notes: val('inp-notes'),
        driver_name: val('inp-driver-name'),
        driver_phone: itiDriver.getNumber() || '',
        license_declared: $<HTMLInputElement>('inp-license').checked,
      };

      if (body.email && body.email !== val('inp-email-confirm')) {
        $('inp-email-confirm').classList.add('error-field');
        return fail('Le email non corrispondono.');
      }
      // Same validation as the server
      const checked = parseBookingDetails(body);
      if (typeof checked === 'string') {
        if (!body.license_declared) $('declaration').classList.add('error-field');
        return fail(checked);
      }
      if (!validRange) return fail('Periodo non valido.');
      errEl.style.display = 'none';

      const btn = $<HTMLButtonElement>('modal-submit');
      btn.disabled = true;
      btn.textContent = 'Invio...';

      const res = await fetch('/api/bookings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...body,
          van: VAN_ID,
          start_at: validRange.start.toISOString(),
          end_at: validRange.end.toISOString(),
        }),
      }).catch(() => null);

      btn.disabled = false;
      btn.textContent = 'Invia richiesta';

      if (res?.ok) {
        $('success-email').textContent = body.email;
        $('modal-form').style.display = 'none';
        $('modal-success').style.display = 'block';
        $('modal-overlay').scrollTop = 0;
        resetForm();
        startPicker.clear(false);
        endPicker.clear(false);
        await loadSlots();
        evaluate();
      } else {
        const data = await res?.json().catch(() => ({}));
        fail(data?.error ?? "Errore durante l'invio della richiesta.");
      }
    });
  </script>
</PublicLayout>
