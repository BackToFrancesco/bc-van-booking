---
import { CONTACT, MAIL_FROM } from '../lib/contact';

interface Props {
  title: string;
  heroTitle: string;
  heroSubtitle: string;
}
const { title, heroTitle, heroSubtitle } = Astro.props;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
      :root { --red: #C8102E; --red-dark: #a00e25; --gray-bg: #f0f0f0; --text: #1a1a1a; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', system-ui, sans-serif; background: var(--gray-bg); color: var(--text); }
      body.modal-open { overflow: hidden; }

      .topbar { background: var(--red); color: white; padding: 0.6rem 2rem; display: flex; align-items: center; gap: 0.75rem; }
      .topbar a { display: flex; align-items: center; gap: 0.75rem; color: inherit; text-decoration: none; }
      .topbar-logo { height: 36px; width: auto; display: block; }
      .topbar-title { font-size: 1rem; font-weight: 600; opacity: 0.92; }

      .page-hero {
        position: relative;
        height: 260px;
        overflow: hidden;
        border-bottom: 3px solid var(--red);
        background:
          radial-gradient(circle at 20% 30%, rgba(255,255,255,.08) 0 18%, transparent 19%),
          radial-gradient(circle at 85% 70%, rgba(255,255,255,.06) 0 22%, transparent 23%),
          linear-gradient(135deg, #1a1a1a 0%, #3a0a12 55%, var(--red) 100%);
      }
      .hero-card {
        position: absolute;
        left: 50%; top: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%;
        max-width: calc(100% - 1rem);
        padding: 0 0.5rem;
      }
      .hero-card h1 {
        font-size: 2.2rem;
        font-weight: 800;
        color: white;
        letter-spacing: -0.01em;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
      }
      .hero-card p {
        font-size: 1.05rem;
        color: white;
        margin-top: 0.6rem;
        font-weight: 600;
        opacity: 0.95;
      }

      .container { max-width: 960px; margin: 2rem auto; padding: 0 1rem; }

      .info-box {
        background: white;
        border-left: 4px solid var(--red);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        font-size: 0.9rem;
        line-height: 1.6;
        color: #444;
        margin-bottom: 1.25rem;
      }
      .info-box strong { color: #1a1a1a; }
      .info-box ul { margin: 0.4rem 0 0; padding-left: 1.2rem; }
      .info-box li { margin-bottom: 0.2rem; }

      .contact-box {
        background: white;
        border-left: 4px solid var(--red);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        font-size: 0.9rem;
        line-height: 1.55;
        color: #444;
        margin-top: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .contact-box strong { color: #1a1a1a; }
      .btn-whatsapp {
        background: #25d366; color: white;
        padding: 0.6rem 1.1rem; border-radius: 6px;
        text-decoration: none; font-size: 0.9rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: 0.5rem;
        transition: background 0.1s, transform 0.1s;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        white-space: nowrap;
      }
      @media (hover: hover) {
        .btn-whatsapp:hover { background: #1da851; }
      }
      .btn-whatsapp:active { background: #1da851; transform: scale(0.96); }

      .btn {
        padding: 0.65rem 1.4rem; border-radius: 7px; border: none; cursor: pointer;
        font-size: 0.95rem; font-weight: 600; font-family: inherit;
        transition: background 0.1s, transform 0.1s;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        text-decoration: none; display: inline-block; text-align: center;
      }
      .btn-primary { background: var(--red); color: white; }
      .btn-secondary { background: #eee; color: #333; }
      .btn:disabled { background: #9ca3af; cursor: not-allowed; }
      @media (hover: hover) {
        .btn-primary:not(:disabled):hover { background: var(--red-dark); }
        .btn-secondary:hover { background: #ddd; }
      }
      .btn-primary:not(:disabled):active { background: var(--red-dark); transform: scale(0.97); }
      .btn-secondary:active { background: #c8c8c8; transform: scale(0.97); }

      footer {
        background: white;
        border-top: 1px solid #e5e5e5;
        padding: 2.5rem 1.5rem 1.75rem;
        margin-top: 3rem;
        text-align: center;
        color: #333;
        font-size: 0.92rem;
        line-height: 1.7;
      }
      footer a { color: inherit; text-decoration: none; }
      footer a:hover { text-decoration: underline; }
      .footer-address { margin-top: 0.25rem; }
      .footer-social { display: flex; justify-content: center; gap: 1rem; margin: 1.25rem 0 1rem; }
      .footer-social a {
        width: 28px; height: 28px; display: inline-flex;
        align-items: center; justify-content: center;
        color: #1a1a1a;
      }
      .footer-social svg { width: 22px; height: 22px; }
      .footer-copy { color: #666; font-size: 0.82rem; margin-top: 0.5rem; }

      @media (max-width: 640px) {
        .topbar { padding: 0.55rem 1rem; }
        .topbar-logo { height: 30px; }
        .topbar-title { font-size: 0.78rem; }
        .page-hero { height: 200px; }
        .hero-card h1 { font-size: 1.85rem; line-height: 1.1; }
        .hero-card p { font-size: 0.95rem; margin-top: 0.5rem; }
        .container { margin: 1rem auto; }
        .contact-box { flex-direction: column; align-items: stretch; }
        .btn-whatsapp { width: 100%; justify-content: center; padding: 0.85rem; min-height: 44px; }
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <div class="topbar">
      <a href="/">
        <img class="topbar-logo" src="/logo.png" alt="Basket Conselve" />
        <span class="topbar-title">Basket Conselve ASD</span>
      </a>
    </div>
    <div class="page-hero">
      <div class="hero-card">
        <h1>{heroTitle}</h1>
        <p>{heroSubtitle}</p>
      </div>
    </div>

    <div class="container">
      <slot />

      {CONTACT && (
      <div class="contact-box">
        <div>
          <strong>Hai dubbi o domande?</strong><br />
          Per qualsiasi necessità, scrivi su WhatsApp a {CONTACT.name} ({CONTACT.phone}).
        </div>
        <a class="btn-whatsapp" href={CONTACT.waLink} target="_blank" rel="noopener" aria-label="Apri WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          Scrivi su WhatsApp
        </a>
      </div>
      )}
    </div>

    <footer>
      <div><a href={`mailto:${MAIL_FROM}`}>{MAIL_FROM}</a></div>
      <div class="footer-address">Via L. Traverso 6, Conselve 35026, PD</div>
      <div class="footer-social">
        <a href="https://www.instagram.com/basketconselve/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href="https://www.facebook.com/basketconselveasd" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"></path>
          </svg>
        </a>
      </div>
      <div class="footer-copy">©{new Date().getFullYear()} di Basket Conselve ASD.</div>
    </footer>
  </body>
</html>
